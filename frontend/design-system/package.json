{
  "name": "@zendo/design-system",
  "version": "0.1.0",
  "type": "module",
  "description": "Self-contained UI component library extracted from Zendo Finance, for use with Claude Design.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && npm run build:css",
    "build:css": "tailwindcss -i src/styles.css -o dist/styles.css --content \"./src/**/*.{ts,tsx}\"",
    "dev": "tsup --watch"
  },
  "peerDependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "dependencies": {
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.3.5",
    "typescript": "~6.0.2"
  }
}
