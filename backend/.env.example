# JWT para sesiones (email/contraseña). En producción usa un secreto largo y aleatorio.
# JWT_SECRET=

# Fintual (fintual.cl) — cookies de sesión del navegador: _fintual_session_cookie y uid.
# Copiar desde las cookies de sesión en fintual.cl (DevTools → Application).
FINTUAL_SESSION=
FINTUAL_UID=
# Opcional: URL del GraphQL de metas/movimientos (por defecto https://fintual.cl/gql/).
# FINTUAL_GQL_GOALS=

# CMF Chile — histórico USD/CLP (registro gratuito) https://api.cmfchile.cl/registro
CMF_API_KEY=
