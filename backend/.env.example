# JWT para sesiones (email/contraseña). En producción usa un secreto largo y aleatorio.
# JWT_SECRET=

# Producción (Postgres gestionado): pegar DATABASE_URL del panel (Render, Railway, Supabase…).
# Railway: suele usarse referencia ${{ NombrePostgres.DATABASE_URL }} en el dashboard en lugar de pegar a mano.
# Sin esta variable el backend usa SQLite local (./portfolio.db).
# DATABASE_URL=

# Orígenes del frontend para CORS (coma, sin espacios problemáticos). Ej.:
# CORS_ORIGINS=https://tu-frontend.onrender.com
# CORS_ORIGINS=https://tu-frontend.up.railway.app

# Fintual (fintual.cl) — cookies de sesión del navegador: _fintual_session_cookie y uid.
# Copiar desde las cookies de sesión en fintual.cl (DevTools → Application).
FINTUAL_SESSION=
FINTUAL_UID=
# Opcional: URL del GraphQL de metas/movimientos (por defecto https://fintual.cl/gql/).
# FINTUAL_GQL_GOALS=

# CMF Chile — histórico USD/CLP (registro gratuito) https://api.cmfchile.cl/registro
CMF_API_KEY=

# Solo desarrollo: al arrancar, borra categorías/subcategorías/movimientos bancarios y repuebla desde data/categorias_banking_default.json (borra tx bancarias).
# RESET_BANKING_CATALOG_ON_STARTUP=1
